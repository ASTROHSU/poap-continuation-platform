{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "titsia-issuer-admin",
  "account_id": "1847680308a50bee067822bdf66cb4d2",
  "main": "workers/admin-gateway/index.ts",
  "compatibility_date": "2026-08-12",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "admin.poap.blocktrend.today",
      "custom_domain": true,
    },
  ],
  "vars": {
    "FRONTEND_ORIGIN": "https://poap.blocktrend.today",
  },
  "secrets": { "required": ["ADMIN_GATEWAY_SECRET"] },
  "services": [
    {
      "binding": "ADMIN_BACKEND",
      "service": "association-poap-pilot",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true,
    },
  },
}
