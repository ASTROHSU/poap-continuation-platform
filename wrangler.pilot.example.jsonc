{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "your-poap-continuation-worker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [],
  "triggers": { "crons": ["* * * * *"] },
  // Add the secret names documented in .dev.vars.example with
  // `wrangler secret put`; Wrangler configuration never stores their values.
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"],
  },
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "your-archive-catalog",
      "database_id": "00000000-0000-0000-0000-000000000001",
    },
    {
      "binding": "HOLDINGS_DB",
      "database_name": "your-archive-holdings",
      "database_id": "00000000-0000-0000-0000-000000000002",
    },
    {
      "binding": "LIVE_DB",
      "database_name": "your-live-events",
      "database_id": "00000000-0000-0000-0000-000000000003",
      "migrations_dir": "migrations/live",
    },
  ],
  "r2_buckets": [
    { "binding": "ARCHIVE_BUCKET", "bucket_name": "your-live-media" },
    { "binding": "ARCHIVE_MEDIA_BUCKET", "bucket_name": "your-archive-media" },
  ],
  "ratelimits": [
    {
      "name": "BROWSE_RATE_LIMITER",
      "namespace_id": "10010001",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "OWNER_RATE_LIMITER",
      "namespace_id": "10010002",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "EXPORT_RATE_LIMITER",
      "namespace_id": "10010003",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
  "vars": {
    "APP_MODE": "live-only",
    "SNAPSHOT_ID": "your-snapshot-id",
    "HOLDINGS_SNAPSHOT_ID": "your-snapshot-id",
    "COLLECTIONS_SNAPSHOT_ID": "no-collections",
    "COLLECTIONS_RELEASE_ID": "no-collections",
    "MOMENTS_SNAPSHOT_ID": "no-moments",
    "MOMENTS_RELEASE_ID": "no-moments",
    "MOMENTS_SOURCE_DATABASE_SHA256": "not-configured",
    "MOMENTS_BUILD_MANIFEST_SHA256": "not-configured",
    "API_CACHE_VERSION": "v1",
    "MEDIA_BASE_URL": "https://your-worker.example.workers.dev/media/archive",
    "ETHEREUM_RPC_URL": "https://ethereum-rpc.publicnode.com",
    "BASE_RPC_URL": "https://sepolia.base.org",
    "BASE_MAINNET_RPC_URL": "https://mainnet.base.org",
    "ARBITRUM_MAINNET_RPC_URL": "https://arb1.arbitrum.io/rpc",
    "GNOSIS_MAINNET_RPC_URL": "https://gnosis-rpc.publicnode.com",
    "PUBLIC_APP_URL": "https://badge.example.org",
    "EMAIL_PROVIDER": "resend",
    "EMAIL_FROM": "Your Organization <badge@example.org>",
    "WALLET_PROVISIONING_MODE": "disabled",
    "MAGIC_PUBLISHABLE_API_KEY": "",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true,
    },
    "traces": { "enabled": false },
  },
  "upload_source_maps": true,
}
