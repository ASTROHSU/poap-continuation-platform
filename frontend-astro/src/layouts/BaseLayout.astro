---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  referrer?: string;
}

const {
  title = "底加｜把做伙的時刻留在這裡",
  description = "底加保存過去的 POAP 記錄，也讓新的共同記憶繼續被收藏。",
  robots = "index,follow",
  referrer = "strict-origin-when-cross-origin",
} = Astro.props;
const socialImage = new URL("/brand/titsia-app-icon-512.png", Astro.url).href;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="referrer" content={referrer} />
    <meta name="theme-color" content="#7C72E2" />
    <meta name="base:app_id" content="6a79bfdcd198f685bc61e2f7" />
    <meta property="og:site_name" content="底加" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/png" sizes="512x512" href="/brand/titsia-app-icon-512.png?v=2" />
    <link rel="shortcut icon" type="image/png" href="/brand/titsia-app-icon-512.png?v=2" />
    <link rel="apple-touch-icon" sizes="512x512" href="/brand/titsia-app-icon-512.png?v=2" />
    <title>{title}</title>
  </head>
  <body class="paper-grid">
    <header class="sticky top-0 z-50 border-b border-white/70 bg-paper/86 backdrop-blur-xl">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-10">
        <a href="/" class="flex min-w-0 items-center gap-3" aria-label="底加首頁">
          <img class="brand-logo" src="/brand/vector/titsia-brand-logo.svg" alt="" width="52" height="52" />
          <span>
            <strong class="block text-base tracking-[.08em]">底加</strong>
            <small class="block whitespace-nowrap text-[9px] font-bold tracking-[.02em] text-ink/48 sm:text-[10px] sm:tracking-[.04em]">把做伙的時刻，留底加。</small>
          </span>
        </a>
        <nav class="hidden items-center gap-7 text-sm font-bold lg:flex" aria-label="主要導覽">
          <a class="transition hover:text-leaf" href="/#what-is-poap">什麼是 POAP</a>
          <a class="transition hover:text-leaf" href="/#how-it-works">如何運作</a>
          <a class="transition hover:text-leaf" href="/#latest-drop">最新 Drop</a>
        </nav>
        <a class="nav-claim" href="/#collection-search-section">查看收藏</a>
      </div>
    </header>
    <main><slot /></main>
    <footer class="overflow-hidden bg-leaf-dark px-5 py-12 text-white/72">
      <div class="mx-auto max-w-7xl lg:px-5">
        <div>
          <p class="text-xl font-bold text-white">底加｜把做伙的時刻，留底加。</p>
          <p class="mt-3 max-w-xl text-sm leading-6 text-white/58">查詢歷史 POAP，也收藏未來的活動紀念。</p>
        </div>
      </div>
    </footer>
  </body>
</html>
