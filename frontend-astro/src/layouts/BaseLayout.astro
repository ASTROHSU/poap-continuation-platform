---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  referrer?: string;
}

const {
  title = "POAP 留存＋新收藏",
  description = "保存過去的 POAP 記錄，讓新的共同記憶繼續被收藏。",
  robots = "index,follow",
  referrer = "strict-origin-when-cross-origin",
} = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="referrer" content={referrer} />
    <meta name="theme-color" content="#5E58A5" />
    <title>{title}</title>
  </head>
  <body class="paper-grid">
    <header class="sticky top-0 z-50 border-b border-white/70 bg-paper/86 backdrop-blur-xl">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-10">
        <a href="/" class="flex items-center gap-3" aria-label="收藏首頁">
          <span class="brand-orbit" aria-hidden="true"><span>P</span></span>
          <span>
            <strong class="block text-sm tracking-[.04em]">POAP 留存計畫</strong>
            <small class="block text-[10px] font-bold tracking-[.06em] text-ink/48">歷史 Archive＋新收藏</small>
          </span>
        </a>
        <nav class="hidden items-center gap-7 text-sm font-bold lg:flex" aria-label="主要導覽">
          <a class="transition hover:text-leaf" href="/#what-is-poap">什麼是 POAP</a>
          <a class="transition hover:text-leaf" href="/#how-it-works">如何運作</a>
          <a class="transition hover:text-leaf" href="/#latest-drop">最新 Drop</a>
        </nav>
        <a class="nav-claim" href="/#collection-search-section">查看收藏</a>
      </div>
    </header>
    <main><slot /></main>
    <footer class="overflow-hidden bg-leaf-dark px-5 py-12 text-white/72">
      <div class="mx-auto grid max-w-7xl gap-8 md:grid-cols-[1fr_auto] md:items-end lg:px-5">
        <div>
          <p class="text-xl font-bold text-white">記憶留下，故事繼續。</p>
          <p class="mt-3 max-w-xl text-sm leading-6 text-white/58">查詢歷史 POAP，也收藏兆量富足教育協會的新活動紀念。</p>
        </div>
        <div class="text-sm md:text-right">
          <a class="font-bold text-white transition hover:text-blush" href="/email/collection">我的收藏</a>
          <p class="mt-3 text-xs text-white/42">社群延續實驗 · 非 POAP 官方服務</p>
        </div>
      </div>
    </footer>
  </body>
</html>
