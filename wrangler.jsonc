{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "association-poap-mvp",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [],
  "triggers": {
    "crons": ["* * * * *"],
  },
  "secrets": {
    "required": [
      "MINT_SIGNER_PRIVATE_KEY",
      "MINT_RELAYER_PRIVATE_KEY",
      "EMAIL_LOOKUP_SECRET",
      "EMAIL_DATA_KEY",
      "RESEND_API_KEY",
    ],
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"],
  },
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "association-poap-catalog",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations/catalog",
    },
    {
      "binding": "HOLDINGS_DB",
      "database_name": "association-poap-holdings-20260702-v1",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "migrations/holdings",
    },
    {
      "binding": "COLLECTIONS_DB",
      "database_name": "association-poap-collections-20260722-v1",
      "database_id": "00000000-0000-0000-0000-000000000003",
      "migrations_dir": "migrations/collections",
    },
    {
      "binding": "MOMENTS_DB",
      "database_name": "association-poap-moments-20260723-v1",
      "database_id": "00000000-0000-0000-0000-000000000004",
      "migrations_dir": "migrations/moments",
    },
    {
      "binding": "LIVE_DB",
      "database_name": "association-poap-live",
      "database_id": "00000000-0000-0000-0000-000000000005",
      "migrations_dir": "migrations/live",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVE_BUCKET",
      "bucket_name": "association-poap-archive",
    },
    {
      "binding": "ARCHIVE_MEDIA_BUCKET",
      "bucket_name": "association-poap-archive-media",
    },
  ],
  "ratelimits": [
    {
      "name": "BROWSE_RATE_LIMITER",
      "namespace_id": "71022001",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "OWNER_RATE_LIMITER",
      "namespace_id": "71022002",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "EXPORT_RATE_LIMITER",
      "namespace_id": "71022003",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
  "vars": {
    "APP_MODE": "combined",
    "SNAPSHOT_ID": "2026-07-02-v1",
    "HOLDINGS_SNAPSHOT_ID": "compass-holdings-2026-07-28-v1",
    "COLLECTIONS_SNAPSHOT_ID": "collections-2026-07-22-v1",
    "COLLECTIONS_RELEASE_ID": "collections-2026-07-22-v1-c1f9213b",
    "MOMENTS_SNAPSHOT_ID": "moments-2026-07-23-v1",
    "MOMENTS_RELEASE_ID": "moments-2026-07-23-v1-media-r1",
    "MOMENTS_SOURCE_DATABASE_SHA256": "d1ffe1d63601f7109bc1c3f87a4e72b1bc91a29f21b92a87c0b037be64fa55cd",
    "MOMENTS_BUILD_MANIFEST_SHA256": "21ef4c8ef6351b59a92210cd0ba4631c5e9ef9034ec0dd5b0ddf9ac3dd702bf3",
    "API_CACHE_VERSION": "v1",
    "MEDIA_BASE_URL": "https://media.example.invalid",
    "ETHEREUM_RPC_URL": "https://ethereum-rpc.publicnode.com",
    "BASE_RPC_URL": "https://sepolia.base.org",
    "BASE_MAINNET_RPC_URL": "https://mainnet.base.org",
    "ARBITRUM_MAINNET_RPC_URL": "https://arb1.arbitrum.io/rpc",
    "GNOSIS_MAINNET_RPC_URL": "https://gnosis-rpc.publicnode.com",
    "PUBLIC_APP_URL": "http://localhost:5173",
    "EMAIL_PROVIDER": "console",
    "EMAIL_FROM": "兆量富足教育協會 <badge@example.invalid>",
    "WALLET_PROVISIONING_MODE": "disabled",
    "MAGIC_PUBLISHABLE_API_KEY": "",
  },
  "limits": {
    "cpu_ms": 250,
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": false,
    },
  },
  "upload_source_maps": true,
}
